<?xml version="1.0" encoding="UTF-8" standalone="yes"?><w:document xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:o="urn:schemas-microsoft-com:office:office" xmlns:r="http://schemas.openxmlformats.org/officeDocument/2006/relationships" xmlns:m="http://schemas.openxmlformats.org/officeDocument/2006/math" xmlns:v="urn:schemas-microsoft-com:vml" xmlns:wp="http://schemas.openxmlformats.org/drawingml/2006/wordprocessingDrawing" xmlns:w10="urn:schemas-microsoft-com:office:word" xmlns:w="http://schemas.openxmlformats.org/wordprocessingml/2006/main" xmlns:wne="http://schemas.microsoft.com/office/word/2006/wordml" xmlns:sl="http://schemas.openxmlformats.org/schemaLibrary/2006/main" xmlns:a="http://schemas.openxmlformats.org/drawingml/2006/main" xmlns:pic="http://schemas.openxmlformats.org/drawingml/2006/picture" xmlns:c="http://schemas.openxmlformats.org/drawingml/2006/chart" xmlns:lc="http://schemas.openxmlformats.org/drawingml/2006/lockedCanvas" xmlns:dgm="http://schemas.openxmlformats.org/drawingml/2006/diagram" xmlns:wps="http://schemas.microsoft.com/office/word/2010/wordprocessingShape" xmlns:wpg="http://schemas.microsoft.com/office/word/2010/wordprocessingGroup" xmlns:w14="http://schemas.microsoft.com/office/word/2010/wordml" xmlns:w15="http://schemas.microsoft.com/office/word/2012/wordml" xmlns:w16="http://schemas.microsoft.com/office/word/2018/wordml" xmlns:w16cex="http://schemas.microsoft.com/office/word/2018/wordml/cex" xmlns:w16cid="http://schemas.microsoft.com/office/word/2016/wordml/cid" xmlns="http://schemas.microsoft.com/office/tasks/2019/documenttasks" xmlns:cr="http://schemas.microsoft.com/office/comments/2020/reactions"><w:body><w:p w:rsidR="00000000" w:rsidDel="00000000" w:rsidP="00000000" w:rsidRDefault="00000000" w:rsidRPr="00000000" w14:paraId="00000001"><w:pPr><w:spacing w:after="240" w:before="240" w:lineRule="auto"/><w:rPr><w:sz w:val="24"/><w:szCs w:val="24"/></w:rPr></w:pPr><w:r w:rsidDel="00000000" w:rsidR="00000000" w:rsidRPr="00000000"><w:rPr><w:rtl w:val="0"/></w:rPr></w:r></w:p><w:p w:rsidR="00000000" w:rsidDel="00000000" w:rsidP="00000000" w:rsidRDefault="00000000" w:rsidRPr="00000000" w14:paraId="00000002"><w:pPr><w:pStyle w:val="Heading1"/><w:keepNext w:val="0"/><w:keepLines w:val="0"/><w:spacing w:before="480" w:lineRule="auto"/><w:rPr><w:sz w:val="24"/><w:szCs w:val="24"/></w:rPr></w:pPr><w:bookmarkStart w:colFirst="0" w:colLast="0" w:name="_gp0uaypwka7p" w:id="0"/><w:bookmarkEnd w:id="0"/><w:r w:rsidDel="00000000" w:rsidR="00000000" w:rsidRPr="00000000"><w:rPr><w:rFonts w:ascii="Palanquin Dark" w:cs="Palanquin Dark" w:eastAsia="Palanquin Dark" w:hAnsi="Palanquin Dark"/><w:sz w:val="24"/><w:szCs w:val="24"/><w:rtl w:val="0"/></w:rPr><w:t xml:space="preserve">हिंदूहृदयसम्राट शिवसेनाप्रमुख बाळासाहेब ठाकरे</w:t></w:r></w:p><w:p w:rsidR="00000000" w:rsidDel="00000000" w:rsidP="00000000" w:rsidRDefault="00000000" w:rsidRPr="00000000" w14:paraId="00000003"><w:pPr><w:spacing w:after="240" w:before="240" w:lineRule="auto"/><w:rPr><w:i w:val="1"/><w:iCs w:val="1"/><w:sz w:val="24"/><w:szCs w:val="24"/></w:rPr></w:pPr><w:r w:rsidDel="00000000" w:rsidR="00000000" w:rsidRPr="00000000"><w:rPr><w:rFonts w:ascii="Palanquin Dark" w:cs="Palanquin Dark" w:eastAsia="Palanquin Dark" w:hAnsi="Palanquin Dark"/><w:i w:val="1"/><w:iCs w:val="1"/><w:sz w:val="24"/><w:szCs w:val="24"/><w:rtl w:val="0"/></w:rPr><w:t xml:space="preserve">(जन्म : २३ जानेवारी १९२६ – निधन : १७ नोव्हेंबर २०१२)</w:t></w:r></w:p><w:p w:rsidR="00000000" w:rsidDel="00000000" w:rsidP="00000000" w:rsidRDefault="00000000" w:rsidRPr="00000000" w14:paraId="00000004"><w:pPr><w:spacing w:after="240" w:before="240" w:lineRule="auto"/><w:rPr><w:sz w:val="24"/><w:szCs w:val="24"/></w:rPr></w:pPr><w:r w:rsidDel="00000000" w:rsidR="00000000" w:rsidRPr="00000000"><w:rPr><w:rFonts w:ascii="Palanquin Dark" w:cs="Palanquin Dark" w:eastAsia="Palanquin Dark" w:hAnsi="Palanquin Dark"/><w:sz w:val="24"/><w:szCs w:val="24"/><w:rtl w:val="0"/></w:rPr><w:t xml:space="preserve">हिंदुत्वाचा जाज्वल्य अभिमान, मराठी अस्मितेचा बुलंद आवाज आणि लाखो शिवसैनिकांच्या हृदयावर अधिराज्य गाजवणारे व्यक्तिमत्त्व म्हणजे वंदनीय शिवसेनाप्रमुख हिंदूहृदयसम्राट बाळासाहेब ठाकरे! </w:t></w:r><w:r w:rsidDel="00000000" w:rsidR="00000000" w:rsidRPr="00000000"><w:rPr><w:rFonts w:ascii="Palanquin Dark" w:cs="Palanquin Dark" w:eastAsia="Palanquin Dark" w:hAnsi="Palanquin Dark"/><w:sz w:val="24"/><w:szCs w:val="24"/><w:rtl w:val="0"/></w:rPr><w:t xml:space="preserve">मराठी माणसाच्या हक्कांसाठी त्यांनी शिवसेनेची स्थापना केली आणि अखेरच्या श्वासापर्यंत ते त्याच लढ्यासाठी झटत राहिले. कोणतेही शासकीय पद कधीही न भूषवता तमाम मराठी जनतेच्या हृदयसिंहासनावर अधिराज्य गाजवणारे ते अनभिषिक्त सम्राट होते.</w:t></w:r></w:p><w:p w:rsidR="00000000" w:rsidDel="00000000" w:rsidP="00000000" w:rsidRDefault="00000000" w:rsidRPr="00000000" w14:paraId="00000005"><w:pPr><w:spacing w:after="240" w:before="240" w:lineRule="auto"/><w:rPr><w:sz w:val="24"/><w:szCs w:val="24"/></w:rPr></w:pPr><w:r w:rsidDel="00000000" w:rsidR="00000000" w:rsidRPr="00000000"><w:rPr><w:rFonts w:ascii="Palanquin Dark" w:cs="Palanquin Dark" w:eastAsia="Palanquin Dark" w:hAnsi="Palanquin Dark"/><w:sz w:val="24"/><w:szCs w:val="24"/><w:rtl w:val="0"/></w:rPr><w:t xml:space="preserve">स्पष्टवक्तेपणा, रोखठोक विचार, सत्याची निर्भीड बाजू आणि आपल्या माणसासाठी कोणत्याही थराला जाण्याची तयारी, हे बाळासाहेबांच्या व्यक्तिमत्त्वाचे वैशिष्ट्य होते. “पोटात एक आणि ओठात एक” अशी भूमिका त्यांनी आयुष्यात कधीच घेतली नाही. त्यामुळेच जनमानसावर एवढा प्रभाव टाकणारे नेतृत्व महाराष्ट्राने यापूर्वी कधी पाहिले नव्हते आणि भविष्यातही पाहण्याची शक्यता नाही.</w:t></w:r></w:p><w:p w:rsidR="00000000" w:rsidDel="00000000" w:rsidP="00000000" w:rsidRDefault="00000000" w:rsidRPr="00000000" w14:paraId="00000006"><w:pPr><w:spacing w:after="240" w:before="240" w:lineRule="auto"/><w:rPr><w:sz w:val="24"/><w:szCs w:val="24"/></w:rPr></w:pPr><w:r w:rsidDel="00000000" w:rsidR="00000000" w:rsidRPr="00000000"><w:rPr><w:rFonts w:ascii="Palanquin Dark" w:cs="Palanquin Dark" w:eastAsia="Palanquin Dark" w:hAnsi="Palanquin Dark"/><w:sz w:val="24"/><w:szCs w:val="24"/><w:rtl w:val="0"/></w:rPr><w:t xml:space="preserve">बाळासाहेब हे मुळात एक प्रतिभावान पत्रकार आणि जागतिक दर्जाचे व्यंगचित्रकार होते. त्यांचे वडील प्रबोधनकार ठाकरे हे खंदे समाजसुधारक आणि प्रखर विचारवंत होते. अंधश्रद्धा, अस्पृश्यता, बालविवाह आणि हुंडा प्रथेविरोधात त्यांनी कठोर लढा उभारला होता.</w:t></w:r><w:r w:rsidDel="00000000" w:rsidR="00000000" w:rsidRPr="00000000"><w:rPr><w:rFonts w:ascii="Calibri" w:cs="Calibri" w:eastAsia="Calibri" w:hAnsi="Calibri"/><w:sz w:val="24"/><w:szCs w:val="24"/><w:rtl w:val="0"/></w:rPr><w:t xml:space="preserve"> प्रबोधनकारांच्या याच विचारांचा वारसा घेऊन बाळासाहेब पत्रकारिता करत होते. </w:t></w:r><w:r w:rsidDel="00000000" w:rsidR="00000000" w:rsidRPr="00000000"><w:rPr><w:sz w:val="24"/><w:szCs w:val="24"/><w:rtl w:val="0"/></w:rPr><w:t xml:space="preserve"> </w:t></w:r></w:p><w:p w:rsidR="00000000" w:rsidDel="00000000" w:rsidP="00000000" w:rsidRDefault="00000000" w:rsidRPr="00000000" w14:paraId="00000007"><w:pPr><w:spacing w:after="240" w:before="240" w:lineRule="auto"/><w:rPr><w:sz w:val="24"/><w:szCs w:val="24"/></w:rPr></w:pPr><w:r w:rsidDel="00000000" w:rsidR="00000000" w:rsidRPr="00000000"><w:rPr><w:rFonts w:ascii="Palanquin Dark" w:cs="Palanquin Dark" w:eastAsia="Palanquin Dark" w:hAnsi="Palanquin Dark"/><w:sz w:val="24"/><w:szCs w:val="24"/><w:rtl w:val="0"/></w:rPr><w:t xml:space="preserve">१९५० च्या दशकाच्या सुरुवातीला बाळासाहेबांनी मुंबईतील ‘फ्री प्रेस जर्नल’मध्ये व्यंगचित्रकार म्हणून आपल्या कारकिर्दीची सुरुवात केली. त्यांच्या व्यंगचित्रांमधून समाज आणि राजकारणातील विसंगतींवर अचूक प्रहार होत असे. पुढे १९६० च्या दशकात त्यांनी ‘मार्मिक’ हे साप्ताहिक सुरू केले. ‘मार्मिक’मधून त्यांनी मराठी माणसावर होणाऱ्या अन्यायाला आवाज दिला आणि मुंबईतील वाढत्या परप्रांतीय लोंढ्याविरोधात कठोर भूमिका घेतली. या विचारातूनच मराठी माणसाची संघटना असावी, ही भूमिका पुढे आली आणि १९ जून १९६६ रोजी शिवसेनेची स्थापना झाली. मराठी युवकांच्या रोजगाराचा प्रश्न, मुंबईतील मराठी अस्मिता आणि महाराष्ट्राचा स्वाभिमान हे शिवसेनेच्या स्थापनेमागील मुख्य उद्दिष्ट होते.</w:t></w:r></w:p><w:p w:rsidR="00000000" w:rsidDel="00000000" w:rsidP="00000000" w:rsidRDefault="00000000" w:rsidRPr="00000000" w14:paraId="00000008"><w:pPr><w:spacing w:after="240" w:before="240" w:lineRule="auto"/><w:rPr><w:sz w:val="24"/><w:szCs w:val="24"/></w:rPr></w:pPr><w:r w:rsidDel="00000000" w:rsidR="00000000" w:rsidRPr="00000000"><w:rPr><w:rFonts w:ascii="Palanquin Dark" w:cs="Palanquin Dark" w:eastAsia="Palanquin Dark" w:hAnsi="Palanquin Dark"/><w:sz w:val="24"/><w:szCs w:val="24"/><w:rtl w:val="0"/></w:rPr><w:t xml:space="preserve">बाळासाहेबांनी कधीही निवडणूक लढवली नाही किंवा कोणतेही अधिकृत पद स्वीकारले नाही, तरीही महाराष्ट्रातील राजकीय आणि सामाजिक जीवनातील सर्वात प्रभावशाली व्यक्तिमत्त्व म्हणून त्यांचे स्थान अखेरपर्यंत अबाधित राहिले. जनतेने त्यांना प्रेमाने “हिंदूहृदयसम्राट” ही उपाधी बहाल केली.</w:t></w:r></w:p><w:p w:rsidR="00000000" w:rsidDel="00000000" w:rsidP="00000000" w:rsidRDefault="00000000" w:rsidRPr="00000000" w14:paraId="00000009"><w:pPr><w:spacing w:after="240" w:before="240" w:lineRule="auto"/><w:rPr><w:sz w:val="24"/><w:szCs w:val="24"/></w:rPr></w:pPr><w:r w:rsidDel="00000000" w:rsidR="00000000" w:rsidRPr="00000000"><w:rPr><w:rFonts w:ascii="Palanquin Dark" w:cs="Palanquin Dark" w:eastAsia="Palanquin Dark" w:hAnsi="Palanquin Dark"/><w:sz w:val="24"/><w:szCs w:val="24"/><w:rtl w:val="0"/></w:rPr><w:t xml:space="preserve">मराठी अस्मितेबरोबरच हिंदुत्वाला प्राधान्य देणाऱ्या बाळासाहेबांनी राष्ट्रहिताला नेहमी सर्वोच्च स्थान दिले. मुस्लिमांविषयी त्यांची भूमिका स्पष्ट होती. ते म्हणत, “मुसलमानांना आम्ही मुसलमान म्हणून नव्हे, तर या देशाचा राष्ट्रवादी नागरिक म्हणून उभा राहिलेला पाहू इच्छितो. राष्ट्र प्रथम आणि मग धर्म, हीच व्यवहारी समाजवादी विचारधारा आम्ही देऊ इच्छितो.” त्यामुळेच त्यांची भूमिका कायम चर्चेचा विषय ठरली.</w:t></w:r><w:r w:rsidDel="00000000" w:rsidR="00000000" w:rsidRPr="00000000"><w:rPr><w:rFonts w:ascii="Mangal" w:cs="Mangal" w:eastAsia="Mangal" w:hAnsi="Mangal"/><w:sz w:val="24"/><w:szCs w:val="24"/><w:rtl w:val="0"/></w:rPr><w:t xml:space="preserve"> </w:t></w:r><w:r w:rsidDel="00000000" w:rsidR="00000000" w:rsidRPr="00000000"><w:rPr><w:rFonts w:ascii="Palanquin Dark" w:cs="Palanquin Dark" w:eastAsia="Palanquin Dark" w:hAnsi="Palanquin Dark"/><w:sz w:val="24"/><w:szCs w:val="24"/><w:rtl w:val="0"/></w:rPr><w:t xml:space="preserve">त्यामुळेच बाबरी मशीद शिवसैनिकांनी पाडली असेल</w:t></w:r><w:r w:rsidDel="00000000" w:rsidR="00000000" w:rsidRPr="00000000"><w:rPr><w:sz w:val="24"/><w:szCs w:val="24"/><w:rtl w:val="0"/></w:rPr><w:t xml:space="preserve">, </w:t></w:r><w:r w:rsidDel="00000000" w:rsidR="00000000" w:rsidRPr="00000000"><w:rPr><w:rFonts w:ascii="Palanquin Dark" w:cs="Palanquin Dark" w:eastAsia="Palanquin Dark" w:hAnsi="Palanquin Dark"/><w:sz w:val="24"/><w:szCs w:val="24"/><w:rtl w:val="0"/></w:rPr><w:t xml:space="preserve">तर त्याचे स्वागतच आहे</w:t></w:r><w:r w:rsidDel="00000000" w:rsidR="00000000" w:rsidRPr="00000000"><w:rPr><w:sz w:val="24"/><w:szCs w:val="24"/><w:rtl w:val="0"/></w:rPr><w:t xml:space="preserve">, </w:t></w:r><w:r w:rsidDel="00000000" w:rsidR="00000000" w:rsidRPr="00000000"><w:rPr><w:rFonts w:ascii="Palanquin Dark" w:cs="Palanquin Dark" w:eastAsia="Palanquin Dark" w:hAnsi="Palanquin Dark"/><w:sz w:val="24"/><w:szCs w:val="24"/><w:rtl w:val="0"/></w:rPr><w:t xml:space="preserve">असे बाळासाहेब म्हणाले होते. पाकिस्तानला मुंबईत खेळण्यास घातलेली बंदी असो, किंवा पाकधार्जिण्यांवर केलेले थेट भाष्य असो, किंवा बांगलादेशी घुसखोरांविरोधात घेतलेली भूमिका असो</w:t></w:r><w:r w:rsidDel="00000000" w:rsidR="00000000" w:rsidRPr="00000000"><w:rPr><w:sz w:val="24"/><w:szCs w:val="24"/><w:rtl w:val="0"/></w:rPr><w:t xml:space="preserve">, </w:t></w:r><w:r w:rsidDel="00000000" w:rsidR="00000000" w:rsidRPr="00000000"><w:rPr><w:rFonts w:ascii="Palanquin Dark" w:cs="Palanquin Dark" w:eastAsia="Palanquin Dark" w:hAnsi="Palanquin Dark"/><w:sz w:val="24"/><w:szCs w:val="24"/><w:rtl w:val="0"/></w:rPr><w:t xml:space="preserve">किंवा पाकधार्जिण्या पाकड्यांवर केलेले थेट भाष्य असो किंवा बांगलादेशी घुसखोरांवर घेतलेली भूमिका असो</w:t></w:r><w:r w:rsidDel="00000000" w:rsidR="00000000" w:rsidRPr="00000000"><w:rPr><w:sz w:val="24"/><w:szCs w:val="24"/><w:rtl w:val="0"/></w:rPr><w:t xml:space="preserve">, </w:t></w:r><w:r w:rsidDel="00000000" w:rsidR="00000000" w:rsidRPr="00000000"><w:rPr><w:rFonts w:ascii="Palanquin Dark" w:cs="Palanquin Dark" w:eastAsia="Palanquin Dark" w:hAnsi="Palanquin Dark"/><w:sz w:val="24"/><w:szCs w:val="24"/><w:rtl w:val="0"/></w:rPr><w:t xml:space="preserve">यामुळे जागतिक पातळीवरदेखील बाळासाहेबांचे नाव आदराने घेतले जात असे.</w:t></w:r><w:r w:rsidDel="00000000" w:rsidR="00000000" w:rsidRPr="00000000"><w:rPr><w:rFonts w:ascii="Mangal" w:cs="Mangal" w:eastAsia="Mangal" w:hAnsi="Mangal"/><w:sz w:val="24"/><w:szCs w:val="24"/><w:rtl w:val="0"/></w:rPr><w:t xml:space="preserve"> </w:t></w:r><w:r w:rsidDel="00000000" w:rsidR="00000000" w:rsidRPr="00000000"><w:rPr><w:rtl w:val="0"/></w:rPr></w:r></w:p><w:p w:rsidR="00000000" w:rsidDel="00000000" w:rsidP="00000000" w:rsidRDefault="00000000" w:rsidRPr="00000000" w14:paraId="0000000A"><w:pPr><w:spacing w:after="240" w:before="240" w:lineRule="auto"/><w:rPr><w:sz w:val="24"/><w:szCs w:val="24"/></w:rPr></w:pPr><w:r w:rsidDel="00000000" w:rsidR="00000000" w:rsidRPr="00000000"><w:rPr><w:rFonts w:ascii="Palanquin Dark" w:cs="Palanquin Dark" w:eastAsia="Palanquin Dark" w:hAnsi="Palanquin Dark"/><w:sz w:val="24"/><w:szCs w:val="24"/><w:rtl w:val="0"/></w:rPr><w:t xml:space="preserve">बाळासाहेबांची सभा म्हणजे लाखो शिवसैनिकांसाठी पर्वणी असायची. त्यांची भाषणशैली, उपरोधिक विनोद, मार्मिक शब्दप्रयोग आणि आक्रमक ‘ठाकरी शैली’ यामुळे तरुणाई त्यांच्या प्रेमात पडली होती. सभेला आलेल्या युवकांच्या मनातील नेमक्या भावना ओळखून ते भल्या-भल्या नेत्यांचा आपल्या खास ‘ठाकरी शैली’त समाचार घेत असत. त्यांच्या या निर्भीड वृत्तीमुळे ते जनतेच्या मनात घर करून राहिले.</w:t></w:r></w:p><w:p w:rsidR="00000000" w:rsidDel="00000000" w:rsidP="00000000" w:rsidRDefault="00000000" w:rsidRPr="00000000" w14:paraId="0000000B"><w:pPr><w:spacing w:after="240" w:before="240" w:lineRule="auto"/><w:rPr><w:sz w:val="24"/><w:szCs w:val="24"/></w:rPr></w:pPr><w:r w:rsidDel="00000000" w:rsidR="00000000" w:rsidRPr="00000000"><w:rPr><w:rFonts w:ascii="Palanquin Dark" w:cs="Palanquin Dark" w:eastAsia="Palanquin Dark" w:hAnsi="Palanquin Dark"/><w:sz w:val="24"/><w:szCs w:val="24"/><w:rtl w:val="0"/></w:rPr><w:t xml:space="preserve">जातपात विरहित राजकारण आणि “८० टक्के समाजकारण, २० टक्के राजकारण” हे सूत्र देऊन त्यांनी लाखो शिवसैनिक घडवले. राजकीय मतभेद असले तरी वैयक्तिक नात्यांमध्ये त्यांनी नेहमी माणुसकी जपली. विरोधकांच्या आजारपणात किंवा संकटकाळात बाळासाहेबांनी आपुलकीने विचारपूस केली. “मैदान गाजवायचं ते भाषणाने, पण माणुसकी हरवायची नाही,” ही त्यांची शिकवण आजही शिवसैनिकांसाठी मार्गदर्शक आहे.</w:t></w:r></w:p><w:p w:rsidR="00000000" w:rsidDel="00000000" w:rsidP="00000000" w:rsidRDefault="00000000" w:rsidRPr="00000000" w14:paraId="0000000C"><w:pPr><w:spacing w:after="240" w:before="240" w:lineRule="auto"/><w:rPr><w:sz w:val="24"/><w:szCs w:val="24"/></w:rPr></w:pPr><w:r w:rsidDel="00000000" w:rsidR="00000000" w:rsidRPr="00000000"><w:rPr><w:rFonts w:ascii="Palanquin Dark" w:cs="Palanquin Dark" w:eastAsia="Palanquin Dark" w:hAnsi="Palanquin Dark"/><w:sz w:val="24"/><w:szCs w:val="24"/><w:rtl w:val="0"/></w:rPr><w:t xml:space="preserve">आज मुंबईची ओळख बनलेला ‘वडापाव’ घराघरात पोहोचवण्यामागेही बाळासाहेबांची प्रेरणा होती. १९६० च्या दशकात मराठी तरुणांनी उद्योगधंद्याकडे वळावे, स्वाभिमानाने उभे राहावे आणि दाक्षिणात्य उडपी हॉटेल्सना टक्कर द्यावी, या उद्देशाने त्यांनी वडापावच्या गाड्यांना प्रोत्साहन दिले.</w:t></w:r></w:p><w:p w:rsidR="00000000" w:rsidDel="00000000" w:rsidP="00000000" w:rsidRDefault="00000000" w:rsidRPr="00000000" w14:paraId="0000000D"><w:pPr><w:spacing w:after="240" w:before="240" w:lineRule="auto"/><w:rPr><w:sz w:val="24"/><w:szCs w:val="24"/></w:rPr></w:pPr><w:r w:rsidDel="00000000" w:rsidR="00000000" w:rsidRPr="00000000"><w:rPr><w:rFonts w:ascii="Palanquin Dark" w:cs="Palanquin Dark" w:eastAsia="Palanquin Dark" w:hAnsi="Palanquin Dark"/><w:sz w:val="24"/><w:szCs w:val="24"/><w:rtl w:val="0"/></w:rPr><w:t xml:space="preserve">आपल्या ८६ वर्षांच्या प्रदीर्घ कारकिर्दीत बाळासाहेबांनी एक राजनेता, द्रष्टे नेतृत्व, मुत्सद्दी सेनापती, धुरंधर वक्ते, निर्भीड पत्रकार आणि कुशल व्यंगचित्रकार म्हणून त्यांनी देशाच्या राजकारणावर अजरामर ठसा उमटवला. माँसाहेब मीनाताई ठाकरे आणि बिंदुमाधव ठाकरे यांच्या निधनाचे मोठे दुःख त्यांनी अत्यंत धैर्याने सहन केले.</w:t></w:r></w:p><w:p w:rsidR="00000000" w:rsidDel="00000000" w:rsidP="00000000" w:rsidRDefault="00000000" w:rsidRPr="00000000" w14:paraId="0000000E"><w:pPr><w:spacing w:after="240" w:before="240" w:lineRule="auto"/><w:rPr><w:sz w:val="24"/><w:szCs w:val="24"/></w:rPr></w:pPr><w:r w:rsidDel="00000000" w:rsidR="00000000" w:rsidRPr="00000000"><w:rPr><w:rFonts w:ascii="Palanquin Dark" w:cs="Palanquin Dark" w:eastAsia="Palanquin Dark" w:hAnsi="Palanquin Dark"/><w:sz w:val="24"/><w:szCs w:val="24"/><w:rtl w:val="0"/></w:rPr><w:t xml:space="preserve">१७ नोव्हेंबर २०१२ रोजी बाळासाहेबांनी अखेरचा श्वास घेतला. त्यांच्या निधनाची बातमी समजताच कधीही न थांबणारी मुंबई ठप्प झाली होती आणि अवघा महाराष्ट्र शोकसागरात बुडून गेला होता. मराठी बाणा, हिंदू धर्म आणि महाराष्ट्राविषयीचं अफाट प्रेम हीच बाळासाहेबांच्या जीवनाची खरी संजीवनी होती. राजकारण, समाजकारण आणि पत्रकारिता या प्रत्येक क्षेत्रात त्यांनी याच विचारांनी कार्य केले.</w:t></w:r></w:p><w:p w:rsidR="00000000" w:rsidDel="00000000" w:rsidP="00000000" w:rsidRDefault="00000000" w:rsidRPr="00000000" w14:paraId="0000000F"><w:pPr><w:spacing w:after="240" w:before="240" w:lineRule="auto"/><w:rPr><w:sz w:val="24"/><w:szCs w:val="24"/></w:rPr></w:pPr><w:r w:rsidDel="00000000" w:rsidR="00000000" w:rsidRPr="00000000"><w:rPr><w:rFonts w:ascii="Palanquin Dark" w:cs="Palanquin Dark" w:eastAsia="Palanquin Dark" w:hAnsi="Palanquin Dark"/><w:sz w:val="24"/><w:szCs w:val="24"/><w:rtl w:val="0"/></w:rPr><w:t xml:space="preserve">आपल्या उराशी त्यांनी आयुष्यभर जपले ते फक्त दोन शब्द —</w:t></w:r></w:p><w:p w:rsidR="00000000" w:rsidDel="00000000" w:rsidP="00000000" w:rsidRDefault="00000000" w:rsidRPr="00000000" w14:paraId="00000010"><w:pPr><w:spacing w:after="240" w:before="240" w:lineRule="auto"/><w:rPr><w:sz w:val="24"/><w:szCs w:val="24"/></w:rPr></w:pPr><w:r w:rsidDel="00000000" w:rsidR="00000000" w:rsidRPr="00000000"><w:rPr><w:rFonts w:ascii="Palanquin Dark" w:cs="Palanquin Dark" w:eastAsia="Palanquin Dark" w:hAnsi="Palanquin Dark"/><w:sz w:val="24"/><w:szCs w:val="24"/><w:rtl w:val="0"/></w:rPr><w:t xml:space="preserve">जय हिंद! जय महाराष्ट्र!</w:t></w:r></w:p><w:p w:rsidR="00000000" w:rsidDel="00000000" w:rsidP="00000000" w:rsidRDefault="00000000" w:rsidRPr="00000000" w14:paraId="00000011"><w:pPr><w:rPr><w:sz w:val="24"/><w:szCs w:val="24"/></w:rPr></w:pPr><w:r w:rsidDel="00000000" w:rsidR="00000000" w:rsidRPr="00000000"><w:rPr><w:rtl w:val="0"/></w:rPr></w:r></w:p><w:sectPr><w:pgSz w:h="15840" w:w="12240" w:orient="portrait"/><w:pgMar w:bottom="1440" w:top="1440" w:left="1440" w:right="1440" w:header="720" w:footer="720"/><w:pgNumType w:start="1"/></w:sectPr></w:body></w:document>